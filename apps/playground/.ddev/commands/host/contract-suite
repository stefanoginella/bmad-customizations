#!/usr/bin/env bash

## Description: Run the connector<->portal integration suite against the real portal, for the current connector and the previous minor.
## Usage: contract-suite [all|current|previous]
## Example: "ddev contract-suite all" / "ddev contract-suite current"
## ProjectTypes: wordpress
## HostWorkingDir: false

set -euo pipefail

WHICH="${1:-all}"
case "${WHICH}" in
  all | current | previous) ;;
  *)
    echo "ERROR: unknown leg \"${WHICH}\". Use all, current, or previous." >&2
    exit 1
    ;;
esac

APPROOT="${DDEV_APPROOT:?run this through ddev (ddev contract-suite)}"
REPO_ROOT="$(cd "${APPROOT}/../.." && pwd)"
PORTAL_DIR="${REPO_ROOT}/apps/portal"
PORTAL_PROJECT="portal.woptimize"
SITE_URL="${DDEV_PRIMARY_URL:-https://playground.ddev.site}"

# The plugin folder is a symlink. It points at the read-only mount of
# packages/connector; the previous leg repoints it — and only it — at the
# extracted older plugin, then puts it back.
#
# The three spellings of the extraction folder are derived from one name, so a
# rename cannot leave the symlink target and the container path disagreeing.
PLUGIN_LINK="${APPROOT}/wordpress/wp-content/plugins/woptimize-connector"
PLUGIN_LINK_IN_CONTAINER="wordpress/wp-content/plugins/woptimize-connector"
CONNECTOR_MOUNT="/mnt/woptimize/connector"
PREVIOUS_NAME=".previous-connector"
PREVIOUS_DIR="${APPROOT}/${PREVIOUS_NAME}"
PREVIOUS_MOUNT="/var/www/html/${PREVIOUS_NAME}"
PREVIOUS_LINK_TARGET="../../../${PREVIOUS_NAME}"

# Every leg here is invoked from an `if`, which switches `set -e` off for the
# whole call. So every step that may fail says `|| return 1` for itself.

# --- Helpers -----------------------------------------------------------------

artisan() {
  ddev exec -p "${PORTAL_PROJECT}" php artisan "$@"
}

# Both projects must answer before anything else. `ddev start` is idempotent,
# and skipping it on a project that already answers keeps a restart from
# tearing down the sync this command is about to use.
ensure_running() {
  local dir="$1"

  if ! (cd "${dir}" && ddev exec true >/dev/null 2>&1); then
    (cd "${dir}" && ddev start -y >/dev/null)
  fi
}

# Pull `WOPTIMIZE_CONNECTOR_VERSION` out of a plugin main file on stdin.
#
# One parser for both sides of every comparison, so a difference is always a
# real difference and never a difference in how it was read.
parse_connector_version() {
  awk -F"'" '/define\( .WOPTIMIZE_CONNECTOR_VERSION./ { print $4; exit }'
}

# The connector version at HEAD, read from its one definition.
connector_version() {
  parse_connector_version <"${REPO_ROOT}/packages/connector/woptimize-connector.php"
}

# Wait until the container resolves the plugin symlink to the expected target.
#
# Mutagen syncs asynchronously, and a symlink the host already shows can still
# be the old one inside the container — which would silently run the wrong
# plugin for a whole leg.
wait_for_plugin_link() {
  local expected="$1" attempt actual=""

  for attempt in 1 2 3 4 5; do
    actual="$(ddev exec readlink "${PLUGIN_LINK_IN_CONTAINER}" 2>/dev/null | tr -d '\r\n')" || actual=""

    if [ "${actual}" = "${expected}" ]; then
      return 0
    fi

    sleep 1
    ddev mutagen sync >/dev/null 2>&1 || true
  done

  echo "ERROR: the container sees the connector plugin as \"${actual:-nothing}\", expected \"${expected}\"." >&2
  echo "       The host -> container sync did not land. Check 'ddev mutagen status'." >&2
  return 1
}

# Wait until the container reads the expected connector version at the previous
# leg's mount.
#
# A stale directory from an earlier run satisfies a plain existence check, so
# the version is the thing worth waiting for.
wait_for_previous_version() {
  local expected="$1" attempt actual=""

  for attempt in 1 2 3 4 5; do
    actual="$(ddev exec cat "${PREVIOUS_MOUNT}/woptimize-connector.php" 2>/dev/null | parse_connector_version)" || actual=""

    if [ "${actual}" = "${expected}" ]; then
      return 0
    fi

    sleep 1
    ddev mutagen sync >/dev/null 2>&1 || true
  done

  echo "ERROR: the container reads connector \"${actual:-nothing}\" at ${PREVIOUS_MOUNT}, expected \"${expected}\"." >&2
  echo "       The host -> container sync did not land. Try 'ddev restart'." >&2
  return 1
}

# Plant the fixture site on the portal, from whatever state it was in.
#
# Every artisan call here is silenced: `site:onboard` prints the key, and this
# command is the one place that would otherwise put it in a CI log.
reset_fixture() {
  artisan site:offboard "${SITE_URL}" >/dev/null 2>&1 || true
  artisan site:onboard "${SITE_URL}" --key="${FIXTURE_KEY}" >/dev/null || return 1
}

# The tests, in the order the offboarded scenario needs.
#
# `site:offboard` between the two PHPUnit runs is the whole point: only the host
# can reach artisan, so the orchestrator stages that one scenario and the tests
# stay pure observations of `wp option` and `wp cron`.
#
# `ddev exec` forwards no host environment, so the contract path travels inside
# the command string.
run_tests() {
  local contract_file="$1"

  reset_fixture || return 1

  ddev exec "WOPTIMIZE_CONTRACT_FILE=${contract_file} vendor/bin/phpunit --exclude-group offboarded" || return 1

  artisan site:ping "${SITE_URL}" || return 1
  artisan site:status "${SITE_URL}" >/dev/null || return 1

  artisan site:offboard "${SITE_URL}" >/dev/null || return 1

  ddev exec "WOPTIMIZE_CONTRACT_FILE=${contract_file} vendor/bin/phpunit --group offboarded" || return 1
}

# What the connector recorded for its last phone-home.
last_phone_home_result() {
  ddev wp option get woptimize_connector_phone_home --format=json 2>/dev/null \
    | tr -d '\r\n' \
    | sed -n 's/.*"last_result" *: *"\([^"]*\)".*/\1/p'
}

# Leave the portal showing the playground as a live, healthy site.
#
# This runs after every leg, passing or failing: a run that dies in the middle
# must not leave the portal with no row for the playground at all.
freshen_fixture() {
  local result

  reset_fixture || return 1
  ddev wp cron event run woptimize_connector_phone_home >/dev/null || return 1

  # Exit 0 only says WP-Cron fired. AD-7 makes every failure a silent no-op, so
  # the recorded outcome is the only proof the portal actually took the report.
  result="$(last_phone_home_result)" || result=""

  if [ "${result}" != "ok" ]; then
    echo "ERROR: the closing phone-home recorded \"${result:-nothing}\", not \"ok\"." >&2
    return 1
  fi
}

# --- The previous-minor leg --------------------------------------------------

# The highest `plugin-v*` tag with the same MAJOR and a lower MINOR (AD-11,
# Karin's rule). A major bump is a contract break (AD-5), so a `.0` minor after
# one has no previous leg.
previous_tag() {
  local major minor rest tag version tag_major tag_minor

  major="${CURRENT_VERSION%%.*}"
  rest="${CURRENT_VERSION#*.}"
  minor="${rest%%.*}"

  while read -r tag; do
    [ -n "${tag}" ] || continue

    version="${tag#plugin-v}"
    tag_major="${version%%.*}"
    rest="${version#*.}"
    tag_minor="${rest%%.*}"

    case "${tag_major}" in '' | *[!0-9]*) continue ;; esac
    case "${tag_minor}" in '' | *[!0-9]*) continue ;; esac

    [ "${tag_major}" = "${major}" ] || continue
    [ "${tag_minor}" -lt "${minor}" ] || continue

    printf '%s\n' "${tag}"
    return 0
  done < <(git -C "${REPO_ROOT}" tag --list 'plugin-v*' --sort=-v:refname)

  return 1
}

# The plugin symlink goes back to the live repo — and is not believed until the
# container agrees. `PLUGIN_LINK_REPOINTED` stays 1 until then, so the trap
# keeps trying.
restore_plugin_link() {
  ln -sfn "${CONNECTOR_MOUNT}" "${PLUGIN_LINK}"
  ddev mutagen sync >/dev/null 2>&1 || true

  wait_for_plugin_link "${CONNECTOR_MOUNT}" || return 1

  PLUGIN_LINK_REPOINTED=0
}

# Extract one tagged connector and point the plugin symlink at it.
checkout_previous() {
  local tag="$1" extracted

  rm -rf "${PREVIOUS_DIR}"
  mkdir -p "${PREVIOUS_DIR}"

  git -C "${REPO_ROOT}" archive "${tag}" packages/connector \
    | tar -x -C "${PREVIOUS_DIR}" --strip-components=2 || return 1

  extracted="$(parse_connector_version <"${PREVIOUS_DIR}/woptimize-connector.php" 2>/dev/null)" || extracted=""
  if [ -z "${extracted}" ]; then
    echo "ERROR: ${tag} carries no readable WOPTIMIZE_CONNECTOR_VERSION." >&2
    return 1
  fi

  PLUGIN_LINK_REPOINTED=1
  ln -sfn "${PREVIOUS_LINK_TARGET}" "${PLUGIN_LINK}"
  ddev mutagen sync >/dev/null 2>&1 || true

  wait_for_plugin_link "${PREVIOUS_LINK_TARGET}" || return 1
  wait_for_previous_version "${extracted}" || return 1
}

# --- Legs --------------------------------------------------------------------

run_current() {
  local status=0

  run_tests "${CONNECTOR_MOUNT}/openapi.yaml" || status=1
  freshen_fixture || status=1

  return "${status}"
}

run_previous() {
  local tag="$1" status=0

  checkout_previous "${tag}" || status=1

  if [ "${status}" -eq 0 ]; then
    run_tests "${PREVIOUS_MOUNT}/openapi.yaml" || status=1
  fi

  # Back to HEAD's plugin before the closing phone-home, so the portal ends up
  # holding the current version and not the one this leg just exercised.
  restore_plugin_link || status=1
  freshen_fixture || status=1

  return "${status}"
}

# --- Run ---------------------------------------------------------------------

# A leg that dies, or a human who presses Ctrl-C, must never leave the
# playground running last month's plugin. Ctrl-C also has to stop the run — an
# INT trap that only cleans up would fall through into the next leg.
PLUGIN_LINK_REPOINTED=0
restore_if_repointed() {
  if [ "${PLUGIN_LINK_REPOINTED}" -eq 1 ]; then
    restore_plugin_link || true
  fi
}
trap 'restore_if_repointed' EXIT
trap 'restore_if_repointed; exit 130' INT TERM

ensure_running "${APPROOT}"
ensure_running "${PORTAL_DIR}"

CURRENT_VERSION="$(connector_version)" || CURRENT_VERSION=""
if [ -z "${CURRENT_VERSION}" ]; then
  echo "ERROR: no WOPTIMIZE_CONNECTOR_VERSION in packages/connector/woptimize-connector.php." >&2
  echo "       Neither leg can be chosen without it." >&2
  exit 2
fi

if [ ! -d "$(dirname "${PLUGIN_LINK}")" ]; then
  echo "ERROR: ${PLUGIN_LINK} has no parent directory — WordPress is not installed here." >&2
  echo "       Run 'ddev playground-setup' first." >&2
  exit 1
fi

if [ -e "${PLUGIN_LINK}" ] && [ ! -L "${PLUGIN_LINK}" ]; then
  echo "ERROR: ${PLUGIN_LINK} is a real directory, not a symlink." >&2
  echo "       Delete it, then run 'ddev playground-setup'." >&2
  exit 1
fi

# Never inherit a previous run's state: whatever the last run left behind, this
# one starts on the live repo.
if ! restore_plugin_link; then
  echo "ERROR: could not point the connector plugin at ${CONNECTOR_MOUNT}." >&2
  exit 1
fi

FIXTURE_KEY="$(ddev exec printenv WOPTIMIZE_TEST_SITE_KEY 2>/dev/null | tr -d '\r\n' || true)"
if [ -z "${FIXTURE_KEY}" ]; then
  echo "ERROR: WOPTIMIZE_TEST_SITE_KEY is empty in the web container." >&2
  echo "       It is set in .ddev/config.yaml — run 'ddev restart' and try again." >&2
  exit 1
fi

RESULTS=()
FAILED=0

# One line per leg, collected and printed together at the end so the verdict is
# not buried in PHPUnit output. `::notice::` and the step summary put the same
# line where a CI run shows it.
report() {
  local line="$1"

  RESULTS+=("${line}")

  if [ -n "${GITHUB_ACTIONS:-}" ]; then
    echo "::notice::${line}"
  fi
  if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
    echo "${line}" >>"${GITHUB_STEP_SUMMARY}"
  fi
}

if [ "${WHICH}" = "all" ] || [ "${WHICH}" = "current" ]; then
  echo "==> Leg current ..."
  if run_current; then
    report "current: PASS"
  else
    report "current: FAIL"
    FAILED=1
  fi
fi

if [ "${WHICH}" = "all" ] || [ "${WHICH}" = "previous" ]; then
  if PREVIOUS_TAG="$(previous_tag)"; then
    echo "==> Leg previous (${PREVIOUS_TAG}) ..."
    if run_previous "${PREVIOUS_TAG}"; then
      report "previous: PASS (${PREVIOUS_TAG})"
    else
      report "previous: FAIL (${PREVIOUS_TAG})"
      FAILED=1
    fi
  else
    report "previous: SKIPPED — no plugin-v* tag below ${CURRENT_VERSION%.*}"
  fi
fi

echo
if [ "${#RESULTS[@]}" -gt 0 ]; then
  printf '%s\n' "${RESULTS[@]}"
fi

exit "${FAILED}"
