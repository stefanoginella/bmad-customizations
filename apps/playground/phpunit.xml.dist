<?xml version="1.0" encoding="UTF-8"?>
<!--
  The integration suite runs inside the playground web container (PHP 8.1),
  against the real connector on a real WordPress and the real portal. Nothing
  here is mocked, so there is no code-coverage section: the code under test
  lives in packages/connector and apps/portal, not in this project.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         executionOrder="default"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTestsThatDoNotTestAnything="true">
    <testsuites>
        <testsuite name="playground">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
