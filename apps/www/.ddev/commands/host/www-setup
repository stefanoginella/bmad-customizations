#!/usr/bin/env bash

## Description: Build the whole local www dev state: download WordPress, link the theme + site plugin, install the site, activate both.
## Usage: www-setup
## Example: "ddev www-setup"
## ProjectTypes: wordpress
## HostWorkingDir: false

set -euo pipefail

# The one place WordPress is pinned for local dev.
WP_VERSION="${WP_VERSION:-7.1}"

APPROOT="${DDEV_APPROOT:?run this through ddev (ddev www-setup)}"
SITE_URL="${DDEV_PRIMARY_URL:-https://woptimize.ddev.site}"

cd "${APPROOT}"

# Read the version of the WordPress core that is actually on disk. Empty when
# core is absent.
installed_wp_version() {
  [ -f wordpress/wp-includes/version.php ] || return 0
  awk -F"'" '/^\$wp_version *=/ { print $2; exit }' wordpress/wp-includes/version.php
}

# Wait for a host-side path to appear inside the container. Mutagen (macOS,
# Windows) syncs asynchronously; a flush that has not landed resurfaces later as
# a misleading "theme not found".
wait_for_container_path() {
  local path="$1" attempt
  for attempt in 1 2 3 4 5; do
    if ddev exec test -e "${path}" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
    ddev mutagen sync >/dev/null 2>&1 || true
  done
  return 1
}

# --- 0. Design tokens --------------------------------------------------------
# Always the first build step (AD-3). The build reads packages/ and writes into
# both apps, so it runs on the host, not in this project's container — the
# container mounts apps/www only.
if ! command -v npm >/dev/null 2>&1; then
  echo "ERROR: npm was not found on the host." >&2
  echo "       Install Node 24 — see packages/design-tokens/README.md" >&2
  exit 1
fi

# Style Dictionary 5 needs a modern Node. An older one dies deep inside the
# build with an opaque syntax or ESM error, so check the major up front.
if ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 24 ? 0 : 1)' >/dev/null 2>&1; then
  echo "ERROR: the host Node is too old for the design-token build (found $(node -v 2>/dev/null || echo 'no node'))." >&2
  echo "       Install Node 24 — see packages/design-tokens/README.md" >&2
  exit 1
fi

echo "==> Building design tokens ..."
(cd "${APPROOT}/../.." && npm run tokens:build)

# --- 1. WordPress core -------------------------------------------------------
CURRENT_WP="$(installed_wp_version)"
if [ -z "${CURRENT_WP}" ]; then
  echo "==> Downloading WordPress ${WP_VERSION} ..."
  mkdir -p wordpress
  ddev wp core download --version="${WP_VERSION}"
elif [ "${CURRENT_WP}" = "${WP_VERSION}" ]; then
  echo "==> WordPress ${WP_VERSION} already in place — skipping."
else
  echo "==> WordPress ${CURRENT_WP} on disk, pin says ${WP_VERSION} — moving core to the pin ..."
  ddev wp core update --version="${WP_VERSION}" --force
fi

# --- 2. wp-config.php --------------------------------------------------------
# DDEV writes it at start/restart. Deleting wordpress/ takes it with the rest, and
# every later wp-cli call then fails with a confusing error. Fail loudly here.
if [ ! -f wordpress/wp-config.php ]; then
  echo "ERROR: wordpress/wp-config.php is missing — DDEV generates it, not this command." >&2
  echo "       Run 'ddev restart', then run 'ddev www-setup' again." >&2
  exit 1
fi

# --- 3. Relative per-item symlinks ------------------------------------------
# From wordpress/wp-content/<themes|plugins>/, ../../../ resolves to apps/www/.
# Absolute targets break inside the container mount.
echo "==> Asserting wp-content symlinks ..."
mkdir -p wordpress/wp-content/themes wordpress/wp-content/plugins
ln -sfn ../../../themes/woptimize-theme wordpress/wp-content/themes/woptimize-theme
ln -sfn ../../../plugins/woptimize-core wordpress/wp-content/plugins/woptimize-core

# Flush host -> container, then confirm the container really sees both links.
ddev mutagen sync >/dev/null 2>&1 || true
for link in themes/woptimize-theme plugins/woptimize-core; do
  if ! wait_for_container_path "/var/www/html/wordpress/wp-content/${link}"; then
    echo "ERROR: wp-content/${link} never appeared inside the web container." >&2
    echo "       The host -> container sync flush did not land. Check 'ddev mutagen status'," >&2
    echo "       then run 'ddev restart' and try again." >&2
    exit 1
  fi
done

# --- 4. Site install ---------------------------------------------------------
if ddev wp core is-installed >/dev/null 2>&1; then
  echo "==> Site already installed — skipping."
else
  echo "==> Installing WordPress at ${SITE_URL} ..."
  # Local-only credentials. Never used anywhere but this DDEV project.
  ddev wp core install \
    --url="${SITE_URL}" \
    --title="WOptimize (local)" \
    --admin_user=admin \
    --admin_password=admin \
    --admin_email=admin@woptimize.ddev.site \
    --skip-email
fi

# --- 5. Activation -----------------------------------------------------------
echo "==> Activating woptimize-theme + woptimize-core ..."
ddev wp theme activate woptimize-theme
ddev wp plugin activate woptimize-core

echo
echo "Done. ${SITE_URL} — admin / admin at ${SITE_URL}/wp-admin"
