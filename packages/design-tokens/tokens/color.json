{
    "color": {
        "brand": {
            "$type": "color",
            "50": { "$value": "#eef4ff" },
            "100": { "$value": "#dbe6fe" },
            "200": { "$value": "#bed0fd" },
            "300": { "$value": "#92b1fb" },
            "400": { "$value": "#5f88f7" },
            "500": { "$value": "#3b64f2" },
            "600": { "$value": "#2447e0" },
            "700": { "$value": "#1c37b5" },
            "800": { "$value": "#1c3190" },
            "900": { "$value": "#1c2d72" }
        },
        "neutral": {
            "$type": "color",
            "0": { "$value": "#ffffff" },
            "50": { "$value": "#f8fafc" },
            "100": { "$value": "#f1f5f9" },
            "200": { "$value": "#e2e8f0" },
            "300": { "$value": "#cbd5e1" },
            "400": { "$value": "#94a3b8" },
            "500": { "$value": "#64748b" },
            "600": { "$value": "#475569" },
            "700": { "$value": "#334155" },
            "800": { "$value": "#1e293b" },
            "900": { "$value": "#0f172a" }
        },
        "primary": {
            "$type": "color",
            "$value": "{color.brand.600}",
            "$description": "Primary action colour."
        },
        "primary-hover": {
            "$type": "color",
            "$value": "{color.brand.700}"
        },
        "primary-contrast": {
            "$type": "color",
            "$value": "{color.neutral.0}",
            "$description": "Text and icons on top of primary."
        },
        "surface": {
            "$type": "color",
            "$value": "{color.neutral.0}"
        },
        "surface-muted": {
            "$type": "color",
            "$value": "{color.neutral.50}"
        },
        "border": {
            "$type": "color",
            "$value": "{color.neutral.200}"
        },
        "text": {
            "$type": "color",
            "$value": "{color.neutral.800}"
        },
        "text-muted": {
            "$type": "color",
            "$value": "{color.neutral.500}"
        },
        "text-inverse": {
            "$type": "color",
            "$value": "{color.neutral.0}"
        },
        "selection": {
            "$type": "color",
            "$value": "{color.brand.100}",
            "$description": "Background behind selected text."
        }
    }
}
