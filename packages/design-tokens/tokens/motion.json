{
    "duration": {
        "$type": "duration",
        "fast": { "$value": "100ms" },
        "base": { "$value": "150ms" },
        "slow": { "$value": "300ms" }
    },
    "ease": {
        "$type": "cubicBezier",
        "linear": { "$value": [0, 0, 1, 1] },
        "in": { "$value": [0.4, 0, 1, 1] },
        "out": { "$value": [0, 0, 0.2, 1] },
        "in-out": { "$value": [0.4, 0, 0.2, 1] }
    }
}
