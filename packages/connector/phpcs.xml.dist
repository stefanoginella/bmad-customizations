<?xml version="1.0"?>
<ruleset name="WOptimize Connector">
	<description>
		WordPress Coding Standards for the connector, checked at the client-site
		floor: PHP 8.1+, WordPress 6.7+. Not PSR-12 (AD-15).
	</description>

	<file>.</file>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="cache" value="phpcs.cache"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<!-- DDEV runtime files: not ours, and gitignored by DDEV's own .gitignore. -->
	<exclude-pattern>/.ddev/*</exclude-pattern>
	<!-- Hand-written doubles for WordPress core classes: not our code style. -->
	<exclude-pattern>/tests/stubs/*</exclude-pattern>

	<!-- The floor the connector must keep running on. -->
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.7"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="woptimize_connector"/>
				<element value="WOPTIMIZE_CONNECTOR"/>
				<element value="WOptimize\Connector"/>
			</property>
		</properties>
		<!-- The bootstrap defines core's own constants (ABSPATH, *_IN_SECONDS). -->
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- The suite reads files off disk; there is no WP_Filesystem and no HTTP. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="woptimize-connector"/>
			</property>
		</properties>
	</rule>

	<!-- PHPUnit owns test file and class naming; WordPress owns the plugin's. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
